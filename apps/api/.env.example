# ---------------------------------------------------------------------------
# PBAG API — environment configuration
# Copy this file to `.env` and fill in real values before going live.
# Nothing in this file is a real secret; every value below is a placeholder.
# ---------------------------------------------------------------------------

# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# --- Database ---------------------------------------------------------------
# DB_DRIVER=memory   -> uses the built-in JSON file store (no credentials
#                        needed). Great for local dev, demos, and the
#                        `npm run simulate` end-to-end test.
# DB_DRIVER=firestore -> uses Firebase Firestore via firebase-admin. Requires
#                        the FIREBASE_* variables below.
DB_DRIVER=memory

# --- Firebase (required when DB_DRIVER=firestore) ---------------------------
# Create a service account in Firebase Console > Project settings > Service
# accounts > Generate new private key, then either:
#   a) set FIREBASE_SERVICE_ACCOUNT_JSON to the full JSON (single line), or
#   b) set GOOGLE_APPLICATION_CREDENTIALS to a path to the downloaded file.
FIREBASE_PROJECT_ID=pbaginternational-prod
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=

# --- M-Pesa Daraja (Safaricom) -----------------------------------------------
# MPESA_MODE=mock     -> fully simulated STK push/callback, no network call
#                         to Safaricom. Used by default and by the simulation
#                         script so the flow works without any credentials.
# MPESA_MODE=sandbox  -> real calls to the Safaricom Daraja SANDBOX endpoints.
# MPESA_MODE=live     -> real calls to the Safaricom Daraja PRODUCTION endpoints.
MPESA_MODE=mock

MPESA_CONSUMER_KEY=your_daraja_consumer_key
MPESA_CONSUMER_SECRET=your_daraja_consumer_secret
# Sandbox default shortcode/passkey are Safaricom's published test values;
# replace with your own Paybill/Till + passkey for production.
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_CALLBACK_URL=https://your-deployed-api.example.com/api/mpesa/callback
MPESA_BASE_URL=https://sandbox.safaricom.co.ke

# --- Card payments (Stripe recommended) --------------------------------------
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# --- PayPal -------------------------------------------------------------------
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox

# --- Chatbot (optional) -------------------------------------------------------
# If left blank, the chatbot falls back to a fast, offline rule-based FAQ
# assistant (see src/routes/chatbot.ts). Set ANTHROPIC_API_KEY to upgrade it
# to a full Claude-powered assistant.
ANTHROPIC_API_KEY=

# --- Notifications --------------------------------------------------------
SENDGRID_API_KEY=
TICKET_EMAIL_FROM=tickets@pbaginternational.com
